{
    "name": "fantasy-football-draft",
    "version": "1.0.0",
    "type": "module",
    "packageManager": "yarn@4.13.0",
    "engines": {
        "node": "22.x"
    },
    "scripts": {
        "sync-env": "cp .env.local draft/.env && cp .env.local functions/.env",
        "dev": "yarn sync-env && yarn workspace draft dev",
        "preview": "yarn workspace draft preview",
        "start": "yarn workspace draft start",
        "build": "yarn clean && yarn workspace draft build && yarn copy-build && yarn workspace functions build",
        "deploy": "yarn build && firebase deploy",
        "copy-build": "cp -r draft/build functions/",
        "clean": "rm -rf functions/build draft/build functions/lib",
        "typecheck": "tsc --noEmit",
        "biome:all": "yarn lint:fix && yarn format:fix && check:fix",
        "lint": "biome lint .",
        "lint:fix": "biome lint --write",
        "format": "biome format .",
        "format:fix": "biome format --write",
        "check": "biome check .",
        "check:fix": "biome check --write",
        "type-check": "tsc --noEmit",
        "prepare": "husky install",
        "--lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "firebase:login": "firebase login",
        "firebase:init": "firebase init",
        "firebase:deploy": "firebase deploy",
        "local": "yarn sync-env && firebase emulators:start",
        "functions:build": "yarn workspace functions build",
        "functions:dev": "yarn workspace functions serve",
        "functions:deploy": "yarn workspace functions build && firebase deploy --only functions",
        "test": "yarn workspace draft vitest run"
    },
    "workspaces": [
        "draft",
        "functions"
    ],
    "devDependencies": {
        "@biomejs/biome": "^2.0.0"
    },
    "dependencies": {
        "init": "^0.1.2"
    }
}
