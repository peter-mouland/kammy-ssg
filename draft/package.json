    "firebase-admin": "^13.4.0",
    "google-auth-library": "^9.14.1",
    "googleapis": "^144.0.0",
    "isbot": "^5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.7.0"
  },
  "devDependencies": {
    "@react-router/dev": "^7.7.0",
    "@types/node": "^22.7.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "check-unused-css": "^0.1.6",
    "firebase-tools": "^14.4.0",
    "knip": "^5.61.3",
